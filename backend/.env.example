# ==============================================================================
# RepoPilot Backend Configuration Template (.env.example)
# Copy this file to .env for local overrides. Do NOT commit .env or API keys.
# ==============================================================================

# Server Environment Settings
REPOPILOT_HOST=127.0.0.1
REPOPILOT_PORT=8000
REPOPILOT_DB_PATH=.repopilot_data.db

# CORS Allowed Origins (Comma-separated)
REPOPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:80,http://127.0.0.1:80

# Retrieval & Embedding Configuration
SEMANTIC_RETRIEVAL_ENABLED=false
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384

# Optional: External LLM / Embedding Provider Keys (Do NOT commit real keys!)
# OPENAI_API_KEY=sk-proj-xxxxxx
# EMBEDDING_API_BASE=https://api.openai.com/v1
